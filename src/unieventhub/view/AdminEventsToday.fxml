<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 20px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unieventhub.controller.AdminEventsTodayController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Today's Events" />

    <TableView fx:id="eventTable" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colEventName" prefWidth="180.0" text="Event Name" />
            <TableColumn fx:id="colOrganizer" prefWidth="120.0" text="Organizer" />
            <TableColumn fx:id="colStudents" prefWidth="100.0" text="Reg. Count" />
            <TableColumn fx:id="colLocation" prefWidth="200.0" text="Location" />
        </columns>
        <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
    </columnResizePolicy>
    </TableView>
</VBox>
