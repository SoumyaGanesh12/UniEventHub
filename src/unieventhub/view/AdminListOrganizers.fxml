<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="526.0" prefWidth="640.0" spacing="15" style="-fx-padding: 20px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unieventhub.controller.AdminListOrganizersController">

    <!-- Header -->
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="All Registered Organizers" />

    <!-- TableView -->
    <TableView fx:id="tblOrganizers" prefHeight="400.0" prefWidth="640.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
            <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
            <TableColumn fx:id="colEmail" prefWidth="112.00006103515625" text="Email" />
            <TableColumn fx:id="colContact" prefWidth="120.79998779296875" text="Contact Number" />
            <TableColumn fx:id="colClubName" prefWidth="177.60003662109375" text="Club Name" />
        </columns>
        <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
    </columnResizePolicy>
    </TableView>

    <!-- Buttons -->
    <HBox spacing="10">
        <Button fx:id="btnEdit" onAction="#onEditClick" style=" -fx-font-weight: bold;"  text="Edit Selected" />
        <Button fx:id="btnDelete" onAction="#onDeleteClick" style=" -fx-font-weight: bold;" text="Delete Selected" />
    </HBox>
</VBox>
