<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>



<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="unieventhub.controller.RegistrationsPopupController"
      style="-fx-padding:15;">

    <Label fx:id="lblEventName" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <TableView fx:id="registrationsTable" prefWidth="400" prefHeight="300">
    <columns>
        <TableColumn fx:id="colUsername" text="Student Name" prefWidth="200"/>
        <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
    </columns>
</TableView>
    <Label fx:id="lblTotal" style="-fx-font-weight: bold;"/>
   <HBox spacing="10" alignment="CENTER_LEFT">
    <Button fx:id="btnSendReminders" text="Send Reminders" onAction="#onSendReminders" />

    <Label fx:id="lblReminderMessage"
           text="You cannot send reminders for past events."
           visible="false"
           style="-fx-text-fill: red; -fx-font-size: 14;" />

</HBox>

</VBox>
