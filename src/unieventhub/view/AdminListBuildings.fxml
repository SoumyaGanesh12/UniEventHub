<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="640.0" spacing="15" style="-fx-padding: 20px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unieventhub.controller.AdminListBuildingsController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Buildings List" />

    <TableView fx:id="tblBuildings" prefWidth="680" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50" text="ID" />
            <TableColumn fx:id="colName" prefWidth="160.0" text="Building Name" />
            <TableColumn fx:id="colRoomCount" prefWidth="120" text="Current Rooms" />
            <TableColumn fx:id="colMaxRooms" prefWidth="150" text="Max Rooms Allowed" />
            <TableColumn fx:id="colActions" prefWidth="120.0" text="Actions" />
        </columns>
        <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
    </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnAdd" onAction="#onAddClick" style=" -fx-font-weight: bold;" text="Add Building" />
        <Button fx:id="btnEdit" onAction="#onEditClick" style=" -fx-font-weight: bold;" text="Edit Selected" />
        <Button fx:id="btnDelete" onAction="#onDeleteClick" style=" -fx-font-weight: bold;" text="Delete Selected" />
    </HBox>
</VBox>
