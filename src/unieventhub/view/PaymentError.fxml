<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="unieventhub.controller.PaymentErrorController"
            prefWidth="400" prefHeight="250" style="-fx-background-color: #fce4e4;">
    <children>
        <Label layoutX="90" layoutY="60" text="Payment Failed!"
               style="-fx-font-size: 20px; -fx-text-fill: red; -fx-font-weight: bold;" />
        <Label layoutX="55" layoutY="110" text="Please check your card details and try again."
               style="-fx-font-size: 14px;" />
        <Button layoutX="150" layoutY="170" text="Back"
                onAction="#handleBack" />
    </children>
</AnchorPane>