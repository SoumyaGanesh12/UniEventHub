<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="unieventhub.controller.ViewMyEventsController">

    <!-- 🔝 Header -->
    <top>
        <AnchorPane prefHeight="80.0" style="-fx-background-color: #991f36;">
            <children>
                <Label layoutX="80.0" layoutY="21.0" text="My Registered Events" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>

                <ImageView fitHeight="32.0" fitWidth="32.0" layoutX="37.0" layoutY="23.0" preserveRatio="true">
                    <image>
                        <Image url="@../image/userdashboard.png"/>
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
    </top>

    <!-- ⬅️ Sidebar -->
    <left>
        <AnchorPane prefWidth="180.0" style="-fx-background-color: #e0e0e0;">
            <children>
                <Label layoutX="55.0" layoutY="20.0" text="MENU">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>

                <VBox layoutX="15.0" layoutY="80.0" spacing="20" alignment="TOP_CENTER">
                    <Button text="Back to Dashboard" onAction="#handleBack"
                            prefWidth="150.0" style="-fx-font-weight: bold;" />
                </VBox>
            </children>
        </AnchorPane>
    </left>

    <!-- 📋 Table -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Here are your registered events:" style="-fx-font-size: 16px;"/>
            <TableView fx:id="myEventsTable" prefHeight="300">
                <columns>
                    <TableColumn fx:id="nameCol" text="Event Name" prefWidth="150"/>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="startTimeCol" text="Start" prefWidth="100"/>
                    <TableColumn fx:id="endTimeCol" text="End" prefWidth="100"/>
                    <TableColumn fx:id="roomCol" text="Room" prefWidth="100"/>
                    <TableColumn fx:id="buildingCol" text="Building" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>