<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unieventhub.controller.AdminDashboardController">
   <top>
      <AnchorPane prefHeight="80.0" style="-fx-background-color: #991f36;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" style="-fx-padding: 20 20 20 20;">
                <ImageView fitHeight="32.0" fitWidth="32.0" preserveRatio="true">
                    <image>
                        <Image url="@../image/userdashboard.png" />
                    </image>
                </ImageView>
                <Label text="Admin Dashboard" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <MenuButton fx:id="profileMenu" style="-fx-font-size: 14px; -fx-background-color: #A7C7E7; -fx-font-weight: bold;">
                    <graphic>
                        <HBox spacing="5">
                            <Label text="👤" />
                            <Label fx:id="lblUserName" />
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem onAction="#onLogout" text="Logout" />
                    </items>
                </MenuButton>
            </HBox>
         </children>
      </AnchorPane>
   </top>

   <left>
      <AnchorPane prefWidth="180.0" style="-fx-background-color: #e0e0e0;" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="sidebarButtons" alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="60.0" AnchorPane.leftAnchor="15.0">
               <Button fx:id="btnAdmEvents" onAction="#onEventsClick" prefWidth="150" text="Events" />
               <Button fx:id="btnAdmStudents" onAction="#onStudentsClick" prefWidth="150" text="Students" />
               <Button fx:id="btnAdmOrganizers" onAction="#onOrganizersClick" prefWidth="150" text="Organizers" />
               <Button fx:id="btnAdmBuildings" onAction="#onBuildingsClick" prefWidth="150" text="Buildings" />
               <Button fx:id="btnAdmAnalytics" onAction="#onAnalyticsClick" prefWidth="150" text="Analytics" />
               <Hyperlink fx:id="hypTdEvents" onAction="#onTodayEventsClick" text="What's happening today?"  textFill="#991f36" underline="true" />
            </VBox>
            <Label layoutX="63.0" layoutY="26.0" text=" MENU:  ">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </left>

   <center>
      <AnchorPane fx:id="contentArea"  />
       <!-- Dynamic Views Loaded Here -->
   </center>
</BorderPane>
