<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="unieventhub.controller.AdminStudentFormController"
          hgap="10" vgap="10" style="-fx-background-color: #e0e0e0;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Edit Student" style="-fx-font-size: 16px; -fx-font-weight: bold;" GridPane.columnSpan="2" GridPane.rowIndex="0" GridPane.columnIndex="0"/>

    <Label text="NEU ID:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <TextField fx:id="txtNeuid" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="First Name:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <TextField fx:id="txtFirstName" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <Label text="Last Name:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <TextField fx:id="txtLastName" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <TextField fx:id="txtEmail" GridPane.rowIndex="4" GridPane.columnIndex="1" />

    <Label text="Contact Number:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <TextField fx:id="txtContact" GridPane.rowIndex="5" GridPane.columnIndex="1" />

    <Label text="College:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <ComboBox fx:id="comboCollege" promptText="Select College" GridPane.rowIndex="6" GridPane.columnIndex="1" />

    <Label text="Course:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-text-fill: #991f36; -fx-font-weight: bold;"/>
    <ComboBox fx:id="comboCourse" promptText="Select Course" GridPane.rowIndex="7" GridPane.columnIndex="1" />

    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.rowIndex="8" GridPane.columnIndex="1">
        <Button text="Cancel" onAction="#onCancelClick"
                style="-fx-background-color: #A7C7E7; -fx-text-fill: black; -fx-font-weight: bold;" />
        <Button text="Save" onAction="#onSaveClick"
                style="-fx-background-color: #A7C7E7; -fx-text-fill: black; -fx-font-weight: bold;" />
    </HBox>

</GridPane>
